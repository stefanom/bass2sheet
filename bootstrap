#!/usr/bin/env bash
# bootstrap: get bass2sheet working on this machine, from a fresh clone to a self-check that passes.
# Safe to run again: each step looks first and does only what is missing.

set -Eeuo pipefail

usage() {
    cat <<'EOF'
./bootstrap [options]

On a Mac it
  1. checks that Homebrew is there (it does not install Homebrew: it says how),
  2. installs what the Brewfile lists and is not there yet (brew bundle; nothing is upgraded),
  3. creates the Python environment in .venv from uv.lock (435 MB of packages to download, 1.3 GB on disk),
  4. downloads the model files the default pipeline uses, 1.1 GB:
       the separation model, 699 MB, into ~/.cache/bass2sheet/models
       the beat model, 81 MB, into ~/.cache/torch/hub/checkpoints
       the second separation model, 336 MB, into ~/.cache/huggingface/hub
  5. runs the self-check (bass2sheet-doctor) and prints three commands to try.

On Linux it lists the system packages to install by hand, then does steps 3 to 5. It needs uv and a C compiler.

Options
  --check              change nothing: say what is there and what is not; exit code 0 when all of it is
  --no-models          skip step 4; the first song then downloads the models itself
  --with-basic-pitch   also set up Basic Pitch, the second opinion behind two of the quality gates,
                       in an environment of its own (.venv-bp: 350 MB more to download, 1.5 GB on disk)
  --with-muscriptor    also install what MuScriptor's program needs to build (cmake, ninja);
                       building it and getting its weights stays with you: docs/muscriptor.md
  -h, --help           this text

Behind a proxy, set HTTPS_PROXY before you run it. docs/install.md has every step by hand.
EOF
}

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
check=0 models=1 basic_pitch=0 muscriptor=0 undone=0
current="reading the options" told=0 problems=0 began=$SECONDS

say() { printf '%s\n' "$*"; }
step() {
    current="$1"
    started=$SECONDS
    printf '\n==> %s\n' "$1"
}
took() { say "    ($((SECONDS - started)) s)"; }
problem() {
    problems=$((problems + 1))
    say "    NOT THERE: $*"
}
fail() {
    told=1
    printf '\nbootstrap: %s\n' "$*" >&2
    exit 1
}
# Whatever stops the script, the last lines say so: it never ends half done without a word.
trap 'code=$?; if [ "$code" -ne 0 ] && [ "$told" -eq 0 ]; then
    printf "\nbootstrap: stopped in the step \"%s\" (exit code %s). The lines above say why.\n" "$current" "$code" >&2
    printf "What was done before it is kept: fix the cause and run ./bootstrap again.\n" >&2
fi' EXIT

for option in "$@"; do
    case "$option" in
        --check) check=1 ;;
        --no-models) models=0 ;;
        --with-basic-pitch) basic_pitch=1 ;;
        --with-muscriptor) muscriptor=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "unknown option: $option"
            ;;
    esac
done

cd "$here"
for file in Brewfile uv.lock pyproject.toml; do
    [ -f "$file" ] || fail "$here has no $file: run this script from a clone of the bass2sheet repository."
done

current="finding out what this machine is"
os="$(uname -s)"
brew_off_path=""

# ---------------------------------------------------------------------------------------------- system packages

if [ "$os" = "Darwin" ]; then
    step "Homebrew"
    brew="$(command -v brew || true)"
    if [ -z "$brew" ]; then
        for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [ -x "$candidate" ]; then
                brew="$candidate"
                brew_off_path="$candidate"
                break
            fi
        done
    fi
    if [ -z "$brew" ]; then
        fail "Homebrew is not installed, and this script does not install it. Install it with the command from https://brew.sh:

    /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"

and run ./bootstrap again. To do without Homebrew, docs/install.md lists what to install by hand."
    fi
    if [ -n "$brew_off_path" ]; then
        eval "$("$brew" shellenv bash)" # for this run; the last lines say how to make it stay
    fi
    say "    $("$brew" --version | head -1) at $("$brew" --prefix)"

    step "Homebrew's packages (Brewfile)"
    export HOMEBREW_NO_ENV_HINTS=1
    if [ "$muscriptor" -eq 1 ]; then
        export HOMEBREW_BASS2SHEET_MUSCRIPTOR=1
    fi
    if unmet="$("$brew" bundle check --file=Brewfile --no-upgrade --verbose 2>&1)"; then
        say "    everything in the Brewfile is installed"
    else
        # brew marks each package that is not there with an arrow; when it says something else, show all of it
        printf '%s\n' "$unmet" | grep '^→' | sed 's/^/    /' || printf '%s\n' "$unmet" | sed 's/^/    /'
        if [ "$check" -eq 1 ]; then
            problem "the packages above. ./bootstrap installs them."
        else
            say "    installing them (brew bundle install --no-upgrade)"
            "$brew" bundle install --file=Brewfile --no-upgrade || fail "Homebrew could not install everything the Brewfile lists. Its lines above name what failed and often the command that mends it. Then run ./bootstrap again."
        fi
    fi
    took
elif [ "$os" = "Linux" ]; then
    step "System packages"
    cat <<'EOF'
    On Linux this script installs no system packages. One is needed: a C compiler, for one Python package
    that is compiled when the environment is created (sudo apt install build-essential).
    bass2sheet runs without the others; each adds something:
      MuseScore 4    the PDF and the pictures of the score. From musescore.org; `mscore` must be on the PATH
      Rubber Band    slower playback that keeps a bass line clean:  sudo apt install rubberband-cli
      yt-dlp         adding a song to the copilot by a link:        uv tool install yt-dlp
      ffmpeg         without it the copy in the Python packages is used:  sudo apt install ffmpeg
      Node.js        for the tests of the pages' scripts only:      sudo apt install nodejs
    The self-check at the end says which of them it did not find.
EOF
else
    fail "this script knows macOS and Linux, and this is $os. docs/install.md lists the steps to do by hand."
fi

# ---------------------------------------------------------------------------------------------- Python environment

step "Python environment (.venv, from uv.lock)"
if ! command -v uv >/dev/null 2>&1; then
    if [ "$check" -eq 1 ]; then
        problem "uv, which creates the Python environment."
    elif [ "$os" = "Darwin" ]; then
        fail "uv is not on the PATH though the Brewfile lists it. Run \`brew install uv\`, then ./bootstrap again."
    else
        fail "uv is not installed. Install it with the command from https://docs.astral.sh/uv/:

    curl -LsSf https://astral.sh/uv/install.sh | sh

open a new terminal so that it is on the PATH, and run ./bootstrap again."
    fi
fi

# A new environment gets Homebrew's Python 3.12, whatever other Python is on the PATH. An environment that is
# already there keeps the Python it has. Without Homebrew's, uv finds a Python 3.12 or downloads one.
python="3.12"
if [ "$os" = "Darwin" ] && [ -x "$("$brew" --prefix)/opt/python@3.12/bin/python3.12" ]; then
    python="$("$brew" --prefix)/opt/python@3.12/bin/python3.12"
fi
has_python_312() { [ -x "$1" ] && "$1" -c 'import sys; sys.exit(sys.version_info[:2] != (3, 12))' 2>/dev/null; }

# One package (diffq, which the separation library asks for) has no built package for Python 3.12 and is
# compiled when the environment is created, so a C compiler has to be there: on a Mac the Xcode command line
# tools, which Homebrew does not work without either. The SDK is named outright. On a Mac whose Xcode is older
# than its command line tools the compiler otherwise takes an SDK that its own linker cannot read, and the
# build stops at "unknown architecture".
if [ "$os" = "Darwin" ] && [ -z "${SDKROOT:-}" ]; then
    if sdk="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null)" && [ -d "$sdk" ]; then
        export SDKROOT="$sdk"
    elif has_python_312 .venv/bin/python; then
        : # the environment is there, so the package is compiled already
    elif [ "$check" -eq 1 ]; then
        problem "a C compiler: one Python package is compiled. \`xcode-select --install\` installs the Xcode command line tools."
    else
        fail "there is no C compiler, and one Python package has to be compiled. Install the Xcode command line tools with \`xcode-select --install\`, wait until that is done, and run ./bootstrap again."
    fi
fi
if has_python_312 .venv/bin/python; then
    sync=(uv sync --locked)
else
    sync=(uv sync --locked --python "$python")
fi

if command -v uv >/dev/null 2>&1; then
    say "    $(uv --version)"
    if [ "$check" -eq 1 ]; then
        if [ ! -x .venv/bin/python ]; then
            problem "the Python environment. ./bootstrap creates it."
        elif "${sync[@]}" --check >/dev/null 2>&1; then
            say "    .venv has what uv.lock lists"
        else
            problem "some of the packages uv.lock lists, or .venv has others. ./bootstrap puts that right."
        fi
    else
        "${sync[@]}" || fail "uv could not create the Python environment; its lines above say why. The usual causes: no network (behind a proxy, set HTTPS_PROXY), no C compiler for the one package that is compiled (on Linux: sudo apt install build-essential), a full disk, or a pyproject.toml changed without \`uv lock\`. Then run ./bootstrap again."
        say "    .venv: $(.venv/bin/python --version 2>&1), $(du -sh .venv | cut -f1 | tr -d ' ') on disk"
    fi
fi
took

# ---------------------------------------------------------------------------------------------- Basic Pitch

if [ "$basic_pitch" -eq 1 ]; then
    step "Basic Pitch, in an environment of its own (.venv-bp)"
    has_basic_pitch() {
        has_python_312 .venv-bp/bin/python && .venv-bp/bin/python -c \
            'import importlib.util as u, sys; sys.exit(0 if u.find_spec("basic_pitch") and u.find_spec("onnxruntime") else 1)' 2>/dev/null
    }
    if has_basic_pitch; then
        say "    already there"
    elif [ "$check" -eq 1 ]; then
        problem "Basic Pitch. ./bootstrap --with-basic-pitch sets it up."
    else
        # Its TensorFlow and ONNX packages do not share an environment with PyTorch well: hence one of its own
        uv venv --clear --python "$python" .venv-bp || fail "uv could not create .venv-bp; its lines above say why."
        uv pip install --python .venv-bp/bin/python basic-pitch onnxruntime 'setuptools<81' || fail "uv could not install Basic Pitch into .venv-bp; its lines above say why. bass2sheet works without it: run ./bootstrap again without --with-basic-pitch to go on."
        has_basic_pitch || fail "Basic Pitch was installed into .venv-bp and still does not load from there."
    fi
    took
fi

# ---------------------------------------------------------------------------------------------- models, self-check

if [ ! -x .venv/bin/python ]; then
    step "Self-check"
    problem "the self-check needs the Python environment."
elif [ "$check" -eq 1 ] || [ "$models" -eq 0 ]; then
    step "Self-check (bass2sheet-doctor)"
    .venv/bin/python -m bass2sheet.doctor || problems=$((problems + 1))
    took
else
    step "Model files, then the self-check (bass2sheet-doctor --fetch-models)"
    code=0
    .venv/bin/python -m bass2sheet.doctor --fetch-models || code=$?
    took
    if [ "$code" -eq 2 ]; then
        undone=1 # what is required is there; a model file could not be downloaded
    elif [ "$code" -ne 0 ]; then
        fail "the self-check did not pass: its lines marked MISSING say what is required and not there, and how to fix each. Run ./bootstrap again once that is fixed; what is downloaded is kept."
    fi
fi

# ---------------------------------------------------------------------------------------------- what now

path_note() {
    if [ -n "$brew_off_path" ]; then
        cat <<EOF

Homebrew is not on your PATH, so a new terminal will not find uv. Put it there for good with

  echo 'eval "\$($brew_off_path shellenv)"' >> ~/.zprofile

and open a new terminal.
EOF
    fi
}

if [ "$problems" -gt 0 ]; then
    path_note
    if [ "$check" -eq 1 ]; then
        fail "not everything is there: see the lines marked NOT THERE or MISSING above. ./bootstrap puts it right."
    fi
    fail "the self-check did not pass: its lines marked MISSING say what is required and not there, and how to fix each."
fi
if [ "$check" -eq 1 ]; then
    told=1
    path_note
    say ""
    say "What is required is there. Nothing was changed."
    exit 0
fi

if [ "$undone" -eq 1 ]; then
    say ""
    say "Not complete after $((SECONDS - began)) s: a model file could not be downloaded. Everything else is in place,"
    say "and bass2sheet can be tried meanwhile:"
else
    say ""
    say "Done in $((SECONDS - began)) s. Try it:"
fi
cat <<'EOF'

  uv run bass2sheet "Artist - Title.mp3"
      one song to a PDF, in a folder beside the song (a 4-minute song takes a few minutes)
  uv run bass2sheet-copilot serve --dir scores
      the copilot: open http://localhost:8770, add a song on its first page and fix its notes
  uv run pytest
      the tests (3 to 5 minutes)
EOF
if [ "$muscriptor" -eq 1 ]; then
    say ""
    if [ "$os" = "Darwin" ]; then
        say "MuScriptor: cmake and ninja are installed. Building its program and getting its weights: docs/muscriptor.md."
    else
        say "MuScriptor: install cmake and ninja yourself (sudo apt install cmake ninja-build), then see docs/muscriptor.md."
    fi
fi
path_note
if [ "$undone" -eq 1 ]; then
    fail "not complete: a model file could not be downloaded. The line marked NOT downloaded above says which and why, and its line marked later says what happens without it. Run ./bootstrap again to try once more; until then the first song that needs the file tries the download itself."
fi
told=1
